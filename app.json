{
  "expo": {
    "name": "Alquiler San Clemente",
    "slug": "alquiler-san-clemente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono.jpg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "statusBar": {
      "style": "dark",
      "backgroundColor": "transparent"
    },
    "ios": {
      "supportsTablet": true,
      "statusBarStyle": "dark",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta aplicación necesita acceso a la cámara para tomar fotos de tus experiencias en San Clemente",
        "NSPhotoLibraryUsageDescription": "Esta aplicación necesita acceso a la galería para guardar y compartir tus fotos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icono.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "statusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "transparent"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icono.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icono.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación necesita acceso a tus fotos para compartir tus experiencias en San Clemente.",
          "cameraPermission": "La aplicación necesita acceso a la cámara para tomar fotos de tus experiencias en San Clemente."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
